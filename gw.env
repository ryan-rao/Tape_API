SHELL=/bin/bash
GATEWAY_CHANGER=/dev/sg1
GATEWAY_ENABLED=true
TAPE_API_MODE=FULL
PWD=/home/tape_api/tape-library-api
GATEWAY_AUTO_LOAD=true
LOGNAME=root
XDG_SESSION_TYPE=tty
GATEWAY_DTE_MAP={"0":"/dev/nst0","2":"/dev/nst1"}
MOTD_SHOWN=pam
ALLOW_DEVICE_OPERATION=true
HOME=/root
LANG=en_US.UTF-8
TEST_MEDIA=IBM015LA
SSH_CONNECTION=172.16.12.72 38394 172.16.12.186 22
ALLOW_WRITE=true
XDG_SESSION_CLASS=user
SELINUX_ROLE_REQUESTED=
LESSOPEN=||/usr/bin/lesspipe.sh %s
USER=root
VDBENCH_HOME=/opt/vdbench/vdbench
SELINUX_USE_CURRENT_RANGE=
SHLVL=1
GATEWAY_DB_DSN=postgresql://postgres@127.0.0.1:5432/tapegw
XDG_SESSION_ID=136473
GATEWAY_DRIVE=/dev/nst1
XDG_RUNTIME_DIR=/run/user/0
S_COLORS=auto
SSH_CLIENT=172.16.12.72 38394 22
DEBUGINFOD_IMA_CERT_PATH=/etc/keys/ima:
GATEWAY_CACHE_DIR=/home/tape_api/archive-cache
which_declare=declare -f
XDG_DATA_DIRS=/root/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
PATH=/root/.local/bin:/root/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/opt/vdbench/vdbench:/opt/ibm/ltfsee/bin
SELINUX_LEVEL_REQUESTED=
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/0/bus
OLDPWD=/root
BASH_FUNC_which%%=() {  ( alias;
 eval ${which_declare} ) | /usr/bin/which --tty-only --read-alias --read-functions --show-tilde --show-dot $@
}
_=/usr/bin/nohup
